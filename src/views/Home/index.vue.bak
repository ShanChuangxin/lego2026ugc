        background: url("https://www.mbcstyle.cn/projects/static/lego2026ugc/logo.jpg") top center no-repeat;
        background-size: 100% 100%;
    }

    // 获取照片
    .get-photo {
        position: absolute;
        top: 2.6rem;
        margin-left: 50%;
        transform: translateX(-50%);
        width: 2.5666rem;
        height: 3.46rem;
        background: url("https://www.mbcstyle.cn/projects/static/lego2026ugc/get-photo.png") top center no-repeat;
        background-size: 100% 100%;
    }

    // 照片展示容器
    .photo-container {
        position: absolute;
        // background-color: skyblue;

        // 根据你的页面设计调整位置
        top: 2.6rem;
        left: 50%;
        transform: translateX(-50%);

        width: 2.5666rem;
        // height: 4rem;

        // 固定为 3:4 竖版比例
        aspect-ratio: 3 / 4;

        overflow: hidden;
        background-color: transparent;

        img {
            display: block;
            width: 100%;
            height: 100%;

            // 保持图片比例，超出容器的部分自动裁剪
            object-fit: cover;
            object-position: center;
            // 避免图片基线或行内元素产生额外空隙
            // vertical-align: top;
        }
    }

    // 免责声明
    .tips {
