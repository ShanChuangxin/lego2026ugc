        height: 4.66rem;
        background: url("https://www.mbcstyle.cn/projects/static/lego2026ugc/slogan-red.png") top center no-repeat;
        background-size: 100% 100%;
    }

    // logo加主题
    .index-logo {
        position: absolute;
        top: 7.2rem;
        margin-left: 50%;
        transform: translateX(-50%);
        width: .62rem;
